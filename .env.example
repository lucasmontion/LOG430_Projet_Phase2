# Copier ce fichier en .env (ne jamais versionner .env)
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changez-moi
# Secret du client administrateur de plateforme (portée clients:create)
CANDRONEX_ADMIN_SECRET=changez-moi-admin
# Secret du compte technique de client-management-service (API d'administration Keycloak)
CLIENT_MANAGEMENT_SERVICE_SECRET=changez-moi-client-management
# Clients B2B de demonstration (Phase 2 : crees d'avance dans le realm)
INSPECTRA_DEMO_SECRET=changez-moi-inspectra
AEROTECH_DEMO_SECRET=changez-moi-aerotech
# Tests seulement : client dont le jeton expire apres 5 s (cas « jeton expire -> 401 »)
JETON_COURT_SECRET=changez-moi-court
# Port publie de la passerelle (8080 par defaut)
GATEWAY_PORT=8080
