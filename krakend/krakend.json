{
  "$schema": "https://www.krakend.io/schema/v2.7/krakend.json",
  "version": 3,
  "name": "CanDroneX API Gateway",
  "port": 8080,
  "timeout": "5s",
  "output_encoding": "no-op",
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "*"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "Idempotency-Key",
        "X-Correlation-Id"
      ],
      "expose_headers": [
        "X-Correlation-Id"
      ]
    }
  },
  "endpoints": [
    {
      "@comment": "UC-02 - Enregistrer un drone (tout client B2B authentifie)",
      "endpoint": "/api/drone-service/v1/drone",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "X-Client-Id",
        "Content-Type",
        "Idempotency-Key",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://drone-service:8081"
          ],
          "url_pattern": "/api/drone-service/v1/drone",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/candronex/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "http://localhost:8081/realms/candronex",
          "audience": [
            "candronex-api"
          ],
          "cache": true,
          "propagate_claims": [
            [
              "azp",
              "X-Client-Id"
            ]
          ]
        }
      }
    },
    {
      "@comment": "UC-02 - Consulter un drone du client authentifie (404 pour le drone d'un autre client)",
      "endpoint": "/api/drone-service/v1/drone/{droneId}",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "X-Client-Id",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://drone-service:8081"
          ],
          "url_pattern": "/api/drone-service/v1/drone/{droneId}",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/candronex/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "http://localhost:8081/realms/candronex",
          "audience": [
            "candronex-api"
          ],
          "cache": true,
          "propagate_claims": [
            [
              "azp",
              "X-Client-Id"
            ]
          ]
        }
      }
    },
    {
      "@comment": "UC-04 - Commander les services d'un drone (Idempotency-Key obligatoire)",
      "endpoint": "/api/commande-service/v1/commande",
      "method": "POST",
      "input_headers": [
        "Authorization",
        "X-Client-Id",
        "Content-Type",
        "Idempotency-Key",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://commande-service:8082"
          ],
          "url_pattern": "/api/commande-service/v1/commande",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/candronex/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "http://localhost:8081/realms/candronex",
          "audience": [
            "candronex-api"
          ],
          "cache": true,
          "propagate_claims": [
            [
              "azp",
              "X-Client-Id"
            ]
          ]
        }
      }
    },
    {
      "@comment": "UC-04 - Consulter une commande du client authentifie (404 pour celle d'un autre client)",
      "endpoint": "/api/commande-service/v1/commande/{commandeId}",
      "method": "GET",
      "input_headers": [
        "Authorization",
        "X-Client-Id",
        "X-Correlation-Id"
      ],
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://commande-service:8082"
          ],
          "url_pattern": "/api/commande-service/v1/commande/{commandeId}",
          "encoding": "no-op"
        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8080/realms/candronex/protocol/openid-connect/certs",
          "disable_jwk_security": true,
          "issuer": "http://localhost:8081/realms/candronex",
          "audience": [
            "candronex-api"
          ],
          "cache": true,
          "propagate_claims": [
            [
              "azp",
              "X-Client-Id"
            ]
          ]
        }
      }
    }
  ]
}
